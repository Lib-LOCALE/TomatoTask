{
	"name": "tomatotask",
	"private": true,
	"version": "1.1.0",
	"description": "An intuitive Pomodoro timer with integrated TodoList for productivity and time management.",
	"author": {
		"name": "Anthony Blanchard",
		"url": "https://github.com/Lib-LOCALE"
	},
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"tauri": "tauri",
		"test": "vitest run",
		"test:unit": "vitest run",
		"test:e2e": "playwright test",
		"test:coverage": "vitest run --coverage",
		"test:watch": "vitest",
		"screenshots": "playwright test --config playwright.screenshots.config.ts"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@lucide/svelte": "^1.62.0",
		"@playwright/test": "^1.64.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tauri-apps/cli": "^2.12.4",
		"@tsconfig/svelte": "^5.0.8",
		"@types/node": "^22.20.5",
		"@vitest/ui": "^5.0.5",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"jsdom": "^26.1.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.7",
		"tailwind-variants": "^3.3.1",
		"tw-animate-css": "^1.4.0",
		"typescript": "5.9",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	},
	"dependencies": {
		"@fontsource-variable/bodoni-moda": "^5.3.0",
		"@fontsource-variable/source-sans-3": "^5.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@tauri-apps/api": "^2.12.4",
		"@tauri-apps/plugin-dialog": "^2.8.3",
		"@tauri-apps/plugin-fs": "^2.7.1",
		"@tauri-apps/plugin-notification": "^2.7.0",
		"clsx": "^2.1.1",
		"svelte-i18n": "^4.0.1",
		"tailwind-merge": "^3.7.0",
		"tailwindcss": "^4.3.3"
	}
}
